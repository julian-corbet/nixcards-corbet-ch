{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nixcards",
  "compatibility_date": "2026-08-24",
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "nixcards.corbet.ch",
      "custom_domain": true
    }
  ]
}
